{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mokxi: Push to Mokxi",
      "type": "shell",
      "command": "npx --yes @mokxi/cli push",
      "problemMatcher": []
    },
    {
      "label": "Mokxi: Pull from Mokxi",
      "type": "shell",
      "command": "npx --yes @mokxi/cli pull",
      "problemMatcher": []
    },
    {
      "label": "Mokxi: Run in the simulator",
      "type": "shell",
      "command": "npx --yes @mokxi/cli run --seconds 5",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Mokxi: Open in the browser",
      "type": "shell",
      "command": "npx --yes @mokxi/cli open",
      "problemMatcher": []
    },
    {
      "label": "Arduino: Compile (mega25602)",
      "type": "shell",
      "command": "arduino-cli compile --fqbn arduino:avr:mega --output-dir build/Untitled_project_mega25602 Untitled_project_mega25602",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Mokxi: Upload the build to Mokxi (mega25602)",
      "type": "shell",
      "command": "npx --yes @mokxi/cli upload --board mega25602 --firmware build/Untitled_project_mega25602/Untitled_project_mega25602.ino.elf",
      "dependsOn": "Arduino: Compile (mega25602)",
      "problemMatcher": []
    },
    {
      "label": "Arduino: Upload to a real board (mega25602)",
      "type": "shell",
      "command": "arduino-cli upload --fqbn arduino:avr:mega --input-dir build/Untitled_project_mega25602 --port ${input:port} Untitled_project_mega25602",
      "dependsOn": "Arduino: Compile (mega25602)",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "port",
      "type": "promptString",
      "description": "Serial port of the board (arduino-cli board list shows them)",
      "default": "/dev/ttyUSB0"
    }
  ]
}
